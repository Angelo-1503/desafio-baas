NODE_ENV=development
PORT=3000

# MySQL - banco próprio da aplicação BaaS
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=baas
DATABASE_PASSWORD=baas
DATABASE_NAME=baas

# JWT da própria BaaS (independente do token do gateway)
JWT_SECRET=troque-por-um-segredo-forte
JWT_EXPIRES_IN=1d

# Chave usada para criptografar (AES-256-GCM) a senha/token do gateway em repouso
CREDENTIALS_ENCRYPTION_KEY=troque-por-outro-segredo-forte

# Gateway Lera Box (sandbox)
GATEWAY_BASE_URL=https://api.branchpay.com.br/api

# URL pública desta API — usada para registrar os webhooks no gateway.
# Em dev local, use um túnel (ex: ngrok) apontando para a porta 3000, pois o
# gateway precisa alcançar essa URL pela internet para entregar os webhooks.
PUBLIC_BASE_URL=http://localhost:3000

# URL do frontend (CORS + montagem do link de pagamento enviado por e-mail)
FRONTEND_URL=http://localhost:5173

# SMTP para envio do link de pagamento por e-mail (opcional — sem isso o envio é ignorado com log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
