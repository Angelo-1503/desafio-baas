# Gerado via envsubst pelo entrypoint padrão da imagem nginx a partir das vars
# DOMAIN_APP, DOMAIN_API (definidas no .env usado pelo docker-compose.prod.yml).

server {
    listen 80;
    server_name ${DOMAIN_APP};
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 80;
    server_name ${DOMAIN_API};
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN_APP};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN_APP}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_APP}/privkey.pem;

    location / {
        proxy_pass http://frontend:80;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN_API};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN_API}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_API}/privkey.pem;

    # Webhooks do gateway chegam aqui — o body precisa passar intacto (sem
    # buffering/alteração) para a validação de assinatura HMAC funcionar.
    client_max_body_size 5m;

    location / {
        proxy_pass http://backend:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Correlation-Id $http_x_correlation_id;
    }
}
